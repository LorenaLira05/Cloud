# =====================================================================
# Exemplo de Variáveis de Ambiente - Almoxarifado da Cantina-Escola
# COPIE este arquivo para .env e preencha com suas credenciais reais.
# NUNCA envie o arquivo .env para o controle de versão (Git).
# =====================================================================

# Porta onde o servidor HTTP irá escutar (no Azure App Service a porta é injetada automaticamente via PORT)
PORT=8000

# URL de conexão com o banco de dados
# Opção 1: PostgreSQL na Azure (Azure Database for PostgreSQL - Servidor Flexível)
# Formato: postgresql://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/BANCO?sslmode=require
DATABASE_URL=postgresql://gestor_almoxarifado:SenhaFicticiaForte123@servidor-cantina-senac.postgres.database.azure.com:5432/cantina_db?sslmode=require

# Opção 2: Banco Local SQLite para desenvolvimento/testes rápidos sem dependência externa
# DATABASE_URL=sqlite:///banco/almoxarifado.db

# Identificador do Grupo para auditoria e persistência
GRUPO_ID=G02
APP_ENV=production
